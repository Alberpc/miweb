cssPagina: |
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; -webkit-font-smoothing: antialiased; }
        body { overflow-x: hidden; line-height: 1.6; }

        .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* ===== NAV (menú completo, autocontenido) ===== */
        .subnav {
            position: fixed; top: 24px; left: 50%; transform: translateX(-50%);
            z-index: 1000; width: calc(100% - 48px); max-width: 1200px; height: 62px;
            display: flex; align-items: center; justify-content: space-between; padding: 0 12px 0 24px;
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(18px) saturate(180%); -webkit-backdrop-filter: blur(18px) saturate(180%);
            border: 1px solid var(--glass-border); border-radius: 100px;
            box-shadow: 0 8px 30px rgba(14, 17, 22, 0.14);
        }
        .subnav .logo { font-family: var(--font-heading); font-weight: 800; font-size: 1.3rem; color: var(--ink); text-decoration: none; letter-spacing: -0.05em; flex: none; }
        .subnav .logo img { height: 24px; width: auto; display: block; filter: invert(1) brightness(0.12); }
        .nav-menu { display: flex; align-items: center; gap: 30px; }
        .nav-menu a { font-size: 0.9rem; color: var(--ink-mid); text-decoration: none; transition: color 0.3s ease; }
        .nav-menu a:hover, .nav-menu a.current { color: var(--ink); }
        .subnav .cta {
            font-size: 0.8rem; font-weight: 600; color: #fff; text-decoration: none;
            background: var(--cobalt-600); flex: none;
            padding: 11px 22px; border-radius: 100px; border: 1px solid transparent;
            transition: all 0.3s ease; white-space: nowrap;
        }
        .subnav .cta:hover { transform: translateY(-2px); background: var(--cobalt-700); border-color: transparent; box-shadow: 0 4px 15px var(--cobalt-glow); }
        .nav-burger { display: none; background: none; border: none; cursor: pointer; padding: 10px; flex-direction: column; gap: 5px; }
        .nav-burger span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: all 0.3s ease; }
        .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .nav-burger.open span:nth-child(2) { opacity: 0; }
        .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
        .nav-mobile {
            position: fixed; top: 98px; left: 50%; transform: translateX(-50%);
            width: calc(100% - 48px); max-width: 1200px; z-index: 999;
            background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--glass-border); border-radius: 18px; padding: 14px;
            flex-direction: column; gap: 4px; display: none;
            box-shadow: 0 8px 30px rgba(14, 17, 22, 0.14);
        }
        .nav-mobile.open { display: flex; }
        .nav-mobile a { font-size: 0.98rem; color: var(--ink-soft); text-decoration: none; padding: 12px 14px; border-radius: 10px; transition: background 0.25s ease, color 0.25s ease; }
        .nav-mobile a:hover { background: var(--bg-alt); color: var(--ink); }
        .nav-mobile .nav-mobile-cta { background: var(--cobalt-600); color: #fff; font-weight: 600; text-align: center; margin-top: 6px; }
        @media (max-width: 820px) {
            .nav-menu, .subnav > .cta { display: none; }
            .nav-burger { display: flex; }
        }

        /* ===== HERO OSCURO DEL BLOG =====
           Requiere class="inverse" en el <header class="blog-hero">. */
        .blog-hero.inverse { position: relative; padding: 160px 0 40px; text-align: center; }
        .blog-hero-inner { position: relative; z-index: 2; }
        .blog-hero.inverse h1 { font-family: var(--font-heading); font-size: clamp(2.1rem, 4.6vw, 3.1rem); font-weight: 300; letter-spacing: -0.02em; color: var(--on-night); }

        /* ===== GRID DE POSTS (cuerpo claro) ===== */
        .posts { padding: 40px 0 90px; background-color: var(--bg-alt); }
        .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }

        .post-card {
            display: flex; flex-direction: column; text-decoration: none;
            background: var(--bg); border: 1px solid var(--line); border-radius: 14px;
            overflow: hidden; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .post-card:hover { border-color: var(--cobalt-border); transform: translateY(-6px); box-shadow: 0 30px 60px rgba(26,29,35,0.14), 0 0 40px -14px var(--cobalt-glow); }
        .post-thumb { aspect-ratio: 16 / 9; overflow: hidden; background: linear-gradient(135deg, var(--cobalt-tint), var(--bg-alt)); }
        .post-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
        .post-card:hover .post-thumb img { transform: scale(1.05); }
        .post-info { padding: 24px 26px 28px; display: flex; flex-direction: column; flex: 1; }
        .post-cat { font-family: monospace; font-size: 0.7rem; letter-spacing: 0.2em; color: var(--cobalt-600); text-transform: uppercase; margin-bottom: 12px; }
        .post-card h2 { font-family: var(--font-heading); font-size: 1.24rem; font-weight: 600; color: var(--ink); line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 12px; }
        .post-card p { font-size: 0.95rem; color: var(--ink-soft); font-weight: 300; line-height: 1.6; margin-bottom: 20px; flex: 1; }
        .post-meta { display: flex; align-items: center; gap: 12px; font-size: 0.8rem; color: var(--ink-mid); }
        .post-meta .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-decor); }
        .post-more { margin-top: 18px; font-size: 0.88rem; font-weight: 600; color: var(--ink); }
        .post-card:hover .post-more { color: var(--cobalt-600); }

        /* Estado vacío (por si algún día no hay posts) */
        .posts-empty { text-align: center; color: var(--ink-mid); font-weight: 300; padding: 40px 0; }

        @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } .blog-hero.inverse { padding: 130px 0 30px; } }

        /* ===== FOOTER OSCURO =====
           Requiere class="inverse" en el <footer class="footer-section">. */
        .footer-section.inverse { padding: 90px 0 40px; border-top: 1px solid var(--night-600); }
        .footer-grid { display: grid; grid-template-columns: 1.4fr 2fr; gap: 60px; margin-bottom: 60px; }
        .footer-brand-col { max-width: 340px; }
        .footer-logo-wrap { margin-bottom: 20px; }
        .footer-logo-wrap .logo img { height: 26px; width: auto; }
        .footer-brand-desc { font-size: 0.92rem; color: var(--on-night-soft); font-weight: 300; line-height: 1.7; }
        .footer-links-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .footer-links-title { font-family: var(--font-heading); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--on-night); margin-bottom: 18px; }
        .footer-links-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
        .footer-links-list a { font-size: 0.9rem; color: var(--on-night-soft); text-decoration: none; transition: color 0.3s ease; }
        .footer-links-list a:hover { color: var(--on-night); }
        .footer-bottom-bar { display: flex; align-items: center; justify-content: space-between; padding-top: 30px; border-top: 1px solid var(--night-600); flex-wrap: wrap; gap: 20px; }
        .footer-curator { font-size: 0.82rem; color: var(--on-night-mid); }
        .footer-social-wrap { display: flex; align-items: center; gap: 12px; }
        .footer-social-label { font-size: 0.8rem; color: var(--on-night-soft); }
        .footer-social-icons { display: flex; gap: 10px; }
        .footer-social-icons a { color: var(--on-night-soft); display: flex; transition: color 0.3s ease; }
        .footer-social-icons a:hover { color: var(--cobalt-300); }

        .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal.revealed { opacity: 1; transform: none; }

        @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr; gap: 40px; } }
        @media (max-width: 560px) { .subnav { padding: 0 12px 0 20px; } .footer-links-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
        @media (max-width: 480px) {
            .footer-links-grid { grid-template-columns: 1fr; gap: 24px; }
            .footer-bottom-bar { flex-direction: column; align-items: flex-start; gap: 16px; }
        }
