---
    <!-- HERO -->
    <header class="blog-hero inverse">
        <div class="container blog-hero-inner">
            <h1>Blog</h1>
        </div>
    </header>

    <!-- POSTS -->
    <section class="posts">
        <div class="container">
            <div class="posts-grid">
{#- Las tarjetas salen de la coleccion "posts" (src/blog/*.njk), ordenadas
    de mas nueva a mas antigua. Antes estaban escritas a mano aqui, con un
    comentario que decia "duplica este bloque por cada post nuevo": ahora
    basta con crear el .njk del post y su tarjeta aparece sola. -#}
{%- for post in collections.postsPorFecha %}
                <a href="{{ post.url }}" class="post-card reveal">
                    <div class="post-thumb">
                        <img src="{{ post.data.imagen }}" alt="{{ post.data.imagenAlt }}"{% if post.data.imagenLazy %} loading="lazy" decoding="async"{% endif %}>
                    </div>
                    <div class="post-info">
                        <span class="post-cat">{{ post.data.categoria }}</span>
                        <h2>{{ post.data.tituloTarjeta }}</h2>
                        <p>{{ post.data.resumen }}</p>
                        <div class="post-meta">
                            <time datetime="{{ post.data.fecha }}">{{ post.data.fechaTexto }}</time>
                            <span class="dot"></span>
                            <span>{{ post.data.lectura }}</span>
                        </div>
                        <span class="post-more">Leer artículo &rarr;</span>
                    </div>
                </a>
{%- endfor %}
            </div>
        </div>
    </section>
