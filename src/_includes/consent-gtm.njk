{#- consent-gtm.njk — Consent Mode v2 + Google Tag Manager.
    Va primero del <head> a proposito: si el Consent Mode llegara despues
    de gtm.js, la etiqueta ya habria evaluado "denied" y no se re-dispara.
    Identico byte a byte en las 12 paginas del sitio. -#}
    <!-- Google Consent Mode v2: denegado por defecto, o el valor ya guardado
         por el visitante, antes de que cargue GTM (si esto llegara despues
         de gtm.js, la etiqueta ya habria evaluado "denied" y no se re-dispara). -->
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    (function () {
        var consentimientoGuardado = 'denied';
        try {
            var raw = localStorage.getItem('acc_consent_v1');
            if (raw) {
                var data = JSON.parse(raw);
                if (data && data.analytics === true) consentimientoGuardado = 'granted';
            }
        } catch (e) { /* localStorage no disponible: se queda en denied */ }
        gtag('consent', 'default', {
            'analytics_storage': consentimientoGuardado,
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'wait_for_update': 500
        });
    })();
    </script>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ site.gtm }}');</script>
    <!-- End Google Tag Manager -->
