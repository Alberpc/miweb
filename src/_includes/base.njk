{#- ============================================================
    base.njk — esqueleto comun de todas las paginas
    ============================================================
    Reproduce el <head> que hoy esta copiado en 12 paginas. El orden
    de las etiquetas es el del original a proposito: el Consent Mode
    tiene que ir ANTES de GTM (si llega despues, la etiqueta ya habria
    evaluado "denied" y no se re-dispara).

    Variables que espera del frontmatter de cada pagina:
      title, description, slug, ogType, ogTitle, ogDescription, ogImage,
      publicada, modificada, schemas (lista de bloques JSON-LD ya
      serializados), cssExtra, paginaActual
    ============================================================ -#}
<!DOCTYPE html>
<html lang="es">
<head>
{% include "consent-gtm.njk" %}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <title>{{ title }}</title>

    <!-- SEO técnico -->
    <link rel="canonical" href="{{ canonical | default(site.dominio + "/" + slug + "/") }}">
    <meta name="robots" content="{{ robots | default('index, follow') }}">
    <meta name="author" content="{{ site.autor }}">
    <meta name="theme-color" content="{{ themeColor | default(site.themeColor) }}">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico">
    <link rel="apple-touch-icon" href="/assets/img/favicon-512.png">

    <!-- Open Graph -->
    <meta property="og:type" content="{{ ogType | default('article') }}">
    <meta property="og:locale" content="es_ES">
    <meta property="og:url" content="{{ ogUrl | default(canonical) | default(site.dominio + "/" + slug + "/") }}">
    <meta property="og:site_name" content="{{ site.autor }}">
    <meta property="og:title" content="{{ ogTitle | default(title) }}">
    <meta property="og:description" content="{{ ogDescription | default(description) }}">
    <meta property="og:image" content="{{ ogImage }}">
{%- if ogImageSize != false %}
    <meta property="og:image:width" content="{{ ogImageWidth | default('1200') }}">
    <meta property="og:image:height" content="{{ ogImageHeight | default('675') }}">
{%- endif %}
{%- if ogImageAlt %}
    <meta property="og:image:alt" content="{{ ogImageAlt }}">
{%- endif %}
{%- if publicada %}
    <meta property="article:published_time" content="{{ publicada }}">
    <meta property="article:modified_time" content="{{ modificada | default(publicada) }}">
    <meta property="article:author" content="{{ site.autor }}">
{%- endif %}

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ twitterTitle | default(ogTitle) | default(title) }}">
    <meta name="twitter:description" content="{{ twitterDescription | default(ogDescription) | default(description) }}">
    <meta name="twitter:image" content="{{ ogImage }}">
{%- if schemas %}
{% for bloque in schemas %}
    <script type="application/ld+json">
{{ bloque | safe }}
    </script>
{% endfor %}
{%- endif %}

    <!-- Fuentes del sistema Bosque Inteligente: Instrument Serif para los
         titulares e Inter para el cuerpo, las mismas que la home. Los posts
         solo cargaban Inter, y por eso sus titulares no heredaban la serif. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/design-system/tokens.css?v={{ site.cssVersion }}">
    <link rel="stylesheet" href="/css/base.css?v={{ site.cssVersion }}">
    <link rel="stylesheet" href="/css/nav.css?v={{ site.cssVersion }}">
    <link rel="stylesheet" href="/css/botones.css?v={{ site.cssVersion }}">
    <link rel="stylesheet" href="/css/faq.css?v={{ site.cssVersion }}">
    <link rel="stylesheet" href="/css/pie.css?v={{ site.cssVersion }}">
{%- block estilos %}{% endblock %}
    <link rel="stylesheet" href="/assets/cookies/cookie-banner.css?v={{ v.cookieCss }}">
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

{% block cabecera %}{% include "nav.njk" %}{% endblock %}
{% block contenido %}{{ content | safe }}{% endblock %}
{% block pie %}{% include "footer.njk" %}{% endblock %}
{#- [4-sep-2026] WhatsApp y chat en TODAS las paginas, no solo la home.
    Estaban escritos a mano en index.njk / home.njk, asi que el resto del
    sitio se quedaba sin ellos: quien llegaba por un post o una landing
    (que es por donde entra el trafico de busqueda) no tenia el atajo. -#}
{% include "widgets-flotantes.njk" %}
{%- if sinWidgets != true %}
    <link rel="stylesheet" href="/assets/chat/widget-chat.css?v={{ v.chatCss }}">
    <script src="/assets/chat/widget-chat.js?v={{ v.chatJs }}" defer></script>
{%- endif %}
{%- if baseJs != false %}
    <script src="/assets/js/base.js?v={{ v.baseJs }}" defer></script>
{%- endif %}
{%- block scripts %}{% endblock %}
    <script src="/assets/cookies/cookie-banner.js?v={{ v.cookieJs }}" defer></script>
</body>
</html>
