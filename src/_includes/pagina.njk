{#- pagina.njk — layout de las paginas con CSS propio: el indice del
    blog y las de conversion (servicios, diagnostico, no-perder-clientes).
    Comparte nav, pie, <head> y base.js.

    El CSS de cada pagina va en su propio archivo (`cssArchivo`, un
    nombre dentro de src/css/) y se enlaza con <link>, igual que hace
    index.css con la home: son cientos de lineas de una sola pagina, no
    hay nada que deduplicar entre ellas, pero servirlas como archivo
    cacheable es mejor que reinyectarlas inline en cada visita.
    `cssPagina` se mantiene por si algun dia hace falta un puñado de
    reglas sueltas que no merezcan archivo propio.

    `pie` elige otro pie: servicios.html tiene el suyo, con otro copy. -#}
{% extends "base.njk" %}

{% block estilos %}
{%- if cssArchivo %}
    <link rel="stylesheet" href="/css/{{ cssArchivo }}.css?v={{ site.cssVersion }}">
{%- endif %}
{#- [26-sep-2026] cssExtra: un segundo archivo encima del primero. Lo usan
    las paginas de servicio: heredan todo el sistema de
    diagnostico-operativo.css (hero claro, riel, para quien, FAQ, cierre)
    y ponen solo lo suyo en servicio.css, en vez de copiar 600 lineas. -#}
{%- if cssExtra %}
    <link rel="stylesheet" href="/css/{{ cssExtra }}.css?v={{ site.cssVersion }}">
{%- endif %}
{%- if cssPagina %}
    <style>
{{ cssPagina | safe }}
    </style>
{%- endif %}
{% endblock %}


{% block cabecera %}
{% include "nav.njk" %}
{% endblock %}

{% block scripts %}
{%- if usaAurora %}
    <script src="/assets/js/aurora.js?v={{ v.auroraJs }}"></script>
{%- endif %}
{%- if usaBlogFiltro %}
    <script src="/assets/js/blog-filtro.js?v={{ v.blogFiltroJs }}"></script>
{%- endif %}
{%- if usaRielEntregas %}
    <script src="/assets/js/riel-entregas.js?v={{ v.rielEntregasJs }}"></script>
{%- endif %}
{%- if usaFaq %}
    <script src="/assets/js/faq.js?v={{ v.faqJs }}"></script>
{%- endif %}
{%- if jsPagina %}
    <script>
{{ jsPagina | safe }}
    </script>
{%- endif %}
{% endblock %}

{% block pie %}
{%- if pie %}{% include pie %}{% else %}{% include "footer.njk" %}{% endif %}
{% endblock %}
