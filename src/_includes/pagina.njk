{#- pagina.njk — layout de las paginas con CSS propio: el indice del
    blog y las de conversion (servicios, diagnostico, no-perder-clientes).
    Comparte nav, pie, <head> y base.js; el CSS va inline en `cssPagina`
    porque es de una sola pagina y no hay nada que deduplicar.

    `pie` elige otro pie: servicios.html tiene el suyo, con otro copy. -#}
{% extends "base.njk" %}

{% block estilos %}
{%- if cssPagina %}
    <style>
{{ cssPagina | safe }}
    </style>
{%- endif %}
{% endblock %}


{% block cabecera %}
{% include "nav.njk" %}
{% endblock %}

{% block scripts %}
{%- if jsPagina %}
    <script>
{{ jsPagina | safe }}
    </script>
{%- endif %}
{% endblock %}

{% block pie %}
{%- if pie %}{% include pie %}{% else %}{% include "footer.njk" %}{% endif %}
{% endblock %}
