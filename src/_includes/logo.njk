{#- Logo en texto. Sale de site.json → marca, para poder cambiar de
    nombre (contravía u otro) sin tocar plantillas. Con partido: true se
    usa el corte por arriba de la propuesta de NOI. -#}
<span class="logo-marca{% if not site.marca.partido %} logo-marca--entera{% endif %}" aria-hidden="true">{{ site.marca.nombre }}</span><span class="logo-sub" aria-hidden="true">{{ site.marca.sub }}</span>
