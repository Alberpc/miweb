{#- ============================================================
    nav.njk — LA cabecera del sitio. Una sola, para todas.
    ============================================================
    Antes habia dos casi identicas (.navbar en la home, .subnav en
    blog y posts) mas una tercera copia del CSS dentro del propio
    blog. De ahi venia que el boton del blog se quedara MARRON
    mientras el de la home ya era dorado: al estar duplicadas, se
    desincronizaban.

    Parametros (frontmatter de cada pagina):
      navLocal: true   -> enlaces al ancla de la MISMA pagina
                          (#soluciones en vez de /#soluciones). Solo
                          la home, que es donde viven esas secciones.
      navCtaHref/Texto -> el boton. La home lleva al diagnostico;
                          blog y posts, a contacto.
      navCtaCorto      -> version corta del texto para pantallas
                          estrechas (la home la usa).
      paginaActual     -> marca el enlace activo.
      navBlogHref      -> destino de "Blog" (en /blog/ apunta a "/").
    ============================================================ -#}
{%- set raiz = "" if navLocal else "/" -%}
    <nav class="navbar">
        <div class="nav-container">
            <a href="{{ "#" if navLocal else "/" }}" class="logo"><img src="/assets/img/logo-alber-blanco.png" alt="{{ site.nombre }}"></a>
            <div class="nav-menu">
                <a href="{{ raiz }}#soluciones" class="nav-link{% if paginaActual == "servicios" %} current{% endif %}">Servicios</a>
                <a href="{{ raiz }}#caminos" class="nav-link{% if paginaActual == "caminos" %} current{% endif %}">Cómo Empezar</a>
                <a href="{{ raiz }}#sobre-mi" class="nav-link{% if paginaActual == "sobre-mi" %} current{% endif %}">Sobre Mí</a>
                <a href="{{ navBlogHref | default("/blog/") }}" class="nav-link{% if paginaActual == "blog" %} current{% endif %}">Blog</a>
            </div>
            <a href="{{ navCtaHref | default("/#contacto") }}" class="nav-btn">
{%- if navCtaCorto %}<span class="full-text">{{ navCtaTexto | safe }}</span><span class="short-text">{{ navCtaCorto | safe }}</span>
{%- else %}{{ navCtaTexto | default("Cuéntame tu caso &rarr;") | safe }}
{%- endif %}</a>
            <button class="nav-burger" id="nav-burger" aria-label="Abrir menú" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
        <div class="nav-mobile" id="nav-mobile">
            <a href="{{ raiz }}#soluciones" class="nav-mobile-link">Servicios</a>
            <a href="{{ raiz }}#caminos" class="nav-mobile-link">Cómo Empezar</a>
            <a href="{{ raiz }}#sobre-mi" class="nav-mobile-link">Sobre Mí</a>
            <a href="{{ navBlogHref | default("/blog/") }}" class="nav-mobile-link">Blog</a>
            <a href="{{ navCtaHref | default("/#contacto") }}" class="nav-mobile-cta">{{ navCtaTexto | default("Cuéntame tu caso &rarr;") | safe }}</a>
        </div>
    </nav>
