# ==========================================
# .htaccess — albercabrera.com (web HTML estatica)
# ==========================================

RewriteEngine On

# --- Redireccion www -> no-www (301) ---
RewriteCond %{HTTP_HOST} ^www\.albercabrera\.com [NC]
RewriteRule ^(.*)$ https://albercabrera.com/$1 [L,R=301]

# --- Forzar HTTPS (http -> https) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://albercabrera.com/$1 [L,R=301]

# --- Carpetas de trabajo que NO deben servirse ---------------------------
# Desde que la web se compila con Eleventy, el repo lleva ademas la fuente
# (src/), la copia congelada del HTML de antes (_migracion/) y la config de
# node. El deploy de Hostinger sube la raiz entera, asi que sin esto todo
# eso quedaria accesible por URL. Ver la regla de no dejar notas internas
# en carpetas desplegadas.
RedirectMatch 404 ^/(src|_migracion|_site|node_modules|__pycache__|\.agents|\.claude|_backup-img-original)(/|$)
RedirectMatch 404 ^/(package(-lock)?\.json|\.eleventy\.js|verificar-migracion\.py|skills-lock\.json|comprobar-movil\.sh|\.gitignore)$

# --- URLs limpias: quitar "index.html" de la barra (/index.html -> /) ---
# Solo actua cuando se pide index.html directamente en la barra, no en la
# resolucion interna (asi la carpeta sigue sirviendo su index.html por defecto).
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# --- URLs limpias para las paginas legales (sin .html) ---
# 1) Redirige la version .html a la limpia (coherencia + SEO)
RewriteCond %{THE_REQUEST} \s/+(aviso-legal|cookies|politica-de-privacidad)\.html[\s?] [NC]
RewriteRule ^(aviso-legal|cookies|politica-de-privacidad)\.html$ /$1 [R=301,L]
# 2) Sirve el archivo .html cuando se pide la URL limpia (sin redirigir)
RewriteRule ^(aviso-legal|cookies|politica-de-privacidad)$ $1.html [L]

# --- Pagina 404 personalizada (opcional, si existe) ---
# ErrorDocument 404 /404.html

# --- Cache de archivos estaticos (mejora velocidad) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# --- Compresion GZIP (mejora velocidad) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Link header para descubrimiento por agentes de IA (RFC 8288) ---
# No hay API/documentacion de servicio que enlazar (web de consultoria, no
# producto con API); se apunta al sitemap, que es el recurso real que existe
# y ayuda a un agente a descubrir el contenido del sitio.
<IfModule mod_headers.c>
  Header set Link "</sitemap.xml>; rel=\"sitemap\""
</IfModule>

# --- Content-Type correcto para los .md de cada post (ver .eleventy.js) ---
# Sin esto Apache sirve .md como text/plain o fuerza descarga; un agente que
# pida Accept: text/markdown necesita recibir text/markdown de verdad.
AddType text/markdown;charset=UTF-8 .md
